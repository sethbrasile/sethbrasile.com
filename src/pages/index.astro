---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Seth Brasile — Engineer, Builder, IT/Security | Durant, OK";
const description =
  "Software engineer and operator who helps businesses scale by building systems and automating processes. 12+ years across software, infrastructure, and security.";

const stats = [
  { value: "12+", label: "Years Exp" },
  { value: "75+", label: "Direct Reports" },
  { value: "3.2k", label: "Endpoints Managed" },
  { value: "28", label: "Properties Supported" },
];

const featured = [
  {
    title: "BetterLife member platform",
    description:
      "Founding platform for a financial wellness startup: member application and join flow, small-group matching, payments, and cross-system reporting. As Lead Software Engineer & Architect I set the stack, recruited four hires, and led a six-person team, then adapted a data scientist's R/Python matching algorithms for cloud deployment. Profitable in year one; advisory role since mid-2024.",
    stack: ["Nuxt", "Stripe", "PostgreSQL", "InfluxDB + Grafana", "Go", "Python/R", "Docker/Dokku", "Auth0"],
  },
  {
    title: "List At Ease — Fulcrum Insights contract",
    url: "https://listatease.com/",
    description:
      "Home-listing application built under contract through Fulcrum Insights, February to June 2025. I contributed senior full-stack, DevOps, and architecture work: structured listing data, Cloudflare R2 uploads, agreement signatures, Laravel Cloud configuration, and GitHub Actions deployments. Development is complete; the team made architecture decisions together.",
    stack: ["Laravel", "Vue 3", "TypeScript", "Laravel Cloud", "Cloudflare R2", "GitHub Actions"],
  },
  {
    title: "Endpoint security & compliance automation",
    description:
      "PowerShell and Go tooling for cybersecurity and compliance tracking, Windows update management, and service operations across 2,500–3,200 healthcare and manufacturing endpoints at DKBinnovative. Go programs orchestrated the PowerShell fleet and aggregated results for internal and client reporting. I also led the PrintNightmare response across the client base.",
    stack: ["PowerShell", "Go", "ConnectWise Automate", "Group Policy", "Windows Server"],
  },
  {
    title: "Payment-device tracking for PCI audits",
    description:
      "Enterprise-wide inventory and location tracking for hundreds of payment and POS devices across the Chickasaw Nation's casinos, convenience stores, gas stations, restaurants, and boutique retail. I designed and implemented it as one of two primary retail and payment-systems specialists, and served two years as PCI-DSS subject-matter expert and lead audit preparer.",
    stack: ["PCI-DSS", "POS systems", "Payment terminals", "Vendor evaluation"],
  },
  {
    title: "potluck-planner.com",
    url: "https://potluck-planner.com",
    description:
      "Live event-planning software for invitations, RSVPs, shared contributions, and payments. I conceived the product and direct its AI-assisted development, from architecture and review through integration and operation.",
    stack: ["Next.js 16", "Better Auth", "Neon+Drizzle", "Stripe", "Inngest"],
  },
  {
    title: "Cathode",
    url: "https://cathodeaudio.com",
    description:
      "Guitar-amplifier simulation combining a circuit model with a neural power stage. I directed the work, with Claude Code doing most implementation, and guided integration and validation for model accuracy and real-time audio. Pre-launch.",
    stack: ["C++", "JUCE", "Real-time DSP", "PyTorch", "React", "Nuxt 4", "CF Workers"],
  },
];
---

<BaseLayout title={title} description={description} path="/">
  <article class="max-w-3xl">
    <section class="mb-20 pt-8 animate-fade-up">
      <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 leading-tight">
        Seth builds <span class="text-muted-foreground">&amp;</span> operates.
      </h1>
      <p class="text-xl md:text-2xl text-muted-foreground leading-relaxed mb-10 max-w-2xl">
        I build software and business systems, automate manual work, and operate the
        infrastructure behind them. My background spans enterprise IT, hands-on engineering,
        and leading the people who deliver the work.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="https://pricklypearmarketing.co"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-foreground text-background px-6 py-4 rounded-md font-medium transition-transform hover:-translate-y-1"
        >
          Marketing or SEO? → Prickly Pear Marketing Co
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center border border-border bg-card px-6 py-4 rounded-md font-medium transition-transform hover:-translate-y-1"
        >
          Have a role or project in mind? → Talk with Seth
        </a>
      </div>
    </section>

    <section
      class="mb-20 grid grid-cols-2 md:grid-cols-4 gap-8 border-y border-border py-10 animate-fade-up"
      style="animation-delay: 0.1s"
    >
      {
        stats.map((s) => (
          <div>
            <div class="font-mono text-3xl font-bold mb-1">{s.value}</div>
            <div class="text-sm text-muted-foreground font-medium uppercase tracking-wider">
              {s.label}
            </div>
          </div>
        ))
      }
    </section>

    <section class="mb-20 animate-fade-up" style="animation-delay: 0.2s">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold font-display">Featured Projects</h2>
        <a
          href="/work"
          class="text-sm font-medium flex items-center gap-1 hover:text-primary transition-colors"
        >
          View all <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid gap-6">
        {
          featured.map((p) => (
            <div class="group border border-border bg-card rounded-lg p-6 transition-all hover:border-foreground/50">
              <div class="flex justify-between items-start mb-4">
                <h3 class="text-xl font-bold">{p.title}</h3>
                {p.url && (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground hover:text-foreground"
                    aria-label={`Visit ${p.title}`}
                  >
                    <Icon name="lucide:arrow-up-right" class="size-5" aria-hidden="true" />
                  </a>
                )}
              </div>
              <p class="text-muted-foreground mb-6 leading-relaxed">{p.description}</p>
              <div class="flex flex-wrap gap-2 font-mono text-xs">
                {p.stack.map((tech) => (
                  <span class="bg-secondary px-2 py-1 rounded">{tech}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="mb-20 bg-secondary/50 p-8 rounded-lg border border-border animate-fade-up"
      style="animation-delay: 0.3s"
    >
      <h2 class="text-xl font-bold mb-4 font-display">About Seth</h2>
      <div class="prose prose-neutral dark:prose-invert max-w-none text-muted-foreground space-y-4">
        <p>
          I've built software since 2013, with enterprise IT experience stretching back to
          2012. At the Chickasaw Nation, I supported systems across 28 properties and later
          became one of two primary specialists for retail and payments. I spent two years
          preparing for PCI audits and building the device tracking that supported them.
        </p>
        <p>
          At BetterLife, I led development of the founding platform, recruited four hires,
          and led a six-person team that included me. I also adapted a data scientist's
          R/Python matching code for production. When the business changed, I led the move
          to lower-cost commercial software. At DKBinnovative, my automation work covered
          security and service operations across as many as 3,200 endpoints.
        </p>
        <p>
          Today I lead technical delivery at Prickly Pear Marketing Co and direct independent
          software projects with AI coding agents doing much of the implementation. I own
          architecture, review, integration, and acceptance. The work starts with the business
          need, whether that calls for custom software, an integration, or a vendor product.
        </p>
        <p>
          I'm open to full-time roles in engineering, business systems, and technology
          operations, as well as project conversations. Tell me what needs to work better.
        </p>
      </div>
    </section>

    <section class="border-t border-border pt-10 animate-fade-up" style="animation-delay: 0.4s">
      <div class="flex items-center gap-2 mb-4">
        <Icon name="lucide:cpu" class="size-5 text-muted-foreground" aria-hidden="true" />
        <h2 class="text-lg font-bold font-display">Beyond the Keyboard</h2>
      </div>
      <div class="text-muted-foreground space-y-3">
        <p>
          When I'm not shipping code: I run a homelab I treat like production — yes, I write
          incident reports for outages that only affect me. I build on camera over at{" "}
          <a
            href="https://bytemycache.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-foreground underline underline-offset-2 decoration-muted-foreground/50 hover:decoration-foreground">byteMyCache</a
          >. I build things out of wood, play guitar, and occasionally build the guitar. And I
          co-own a real-estate partnership, because apparently three businesses wasn't enough.
        </p>
        <p>Same instinct every time: take it apart, understand it, make it work better.</p>
      </div>
    </section>
  </article>
</BaseLayout>
