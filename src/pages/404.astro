---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 — Page Not Found | Seth Brasile"
  description="That page doesn't exist."
  path="/404"
>
  <section class="max-w-2xl mx-auto py-20 text-center">
    <p class="font-mono text-7xl font-bold mb-4">404</p>
    <h1 class="text-2xl font-bold font-display mb-4">This page took it apart and didn't put it back.</h1>
    <p class="text-muted-foreground mb-10">
      The page you're looking for doesn't exist or moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center bg-foreground text-background px-6 py-3 rounded-md font-medium transition-transform hover:-translate-y-0.5"
    >
      Back home
    </a>
  </section>
</BaseLayout>
