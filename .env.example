# sethbrasile.com — environment variables
# Copy to .env for local dev. Real secrets live in the Cloudflare Pages dashboard
# (encrypted), NOT in this repo.

# --- Public (safe to expose; build-time, prefixed PUBLIC_) ---
# Cloudflare Turnstile SITE key (public). Defaults to CF's always-pass TEST key
# if unset. Set the real site key in the Pages env for production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Secrets (Cloudflare Pages dashboard → Settings → Environment variables, encrypted) ---
# Turnstile SECRET key — server-side verification. Required (form fails closed without it).
TURNSTILE_SECRET_KEY=
# Resend API key — primary email delivery.
RESEND_API_KEY=
# n8n fallback HMAC shared secret (optional; signing skipped if unset).
N8N_WEBHOOK_SECRET=

# --- Non-secret runtime var (wrangler.toml [vars] or Pages env) ---
# n8n fallback webhook URL (optional).
N8N_WEBHOOK_URL=
